{
  "name": "@siked/traffic-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "siked — gerador de tráfego sintético para popular a demo (só alvo local isolado).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/run.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/run.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "winston": "^3.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
