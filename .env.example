# ─── siked · variáveis de ambiente (exemplo) ───────────────────────────────
# Copie para .env e ajuste. NUNCA commite o .env real.

# --- Portas expostas na demo ---
APP_PORT=3000              # app real seguro (siked_edge)
DECEPTION_PORT=3001        # iscas / honeypots (siked_edge)
DASHBOARD_PORT=8080        # console do SOC (siked_mgmt)

# --- Canal edge → core (ADR-0003) ---
# Porta interna do ingest (não publicada; só alcançável dentro das redes docker).
INGEST_PORT=8081
# Segredo do único caminho permitido do edge para o core (POST /events).
# Gere um valor forte: `openssl rand -hex 32`
INGEST_TOKEN=troque-por-um-segredo-forte

# --- Barramento interno (siked_core) ---
REDIS_URL=redis://redis:6379

# --- Armazenamento (ADR-0002) ---
DATA_DIR=/data                 # volume de custódia
EVENTS_JSONL=/data/events.jsonl
INDEX_SQLITE=/data/index.sqlite

# --- App real seguro ---
NODE_ENV=production
JWT_ISSUER=siked
BODY_LIMIT=64kb                # body cap
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Enriquecimento IA (ADR-0006) — opt-in, desligado por padrão ---
ENRICH_AI=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# --- Vulnerabilidades plantadas (Sprint 3) — SEMPRE false fora do exercício ---
# Ativam as vulns V1..V10 para provar que os gates as barram. Ver security/PLANTED_VULNS.md
PLANT_VULNS=false
